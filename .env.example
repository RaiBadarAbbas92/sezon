# Copy to .env.local and fill in (Supabase Dashboard → Project Settings → API).
# Without these the store runs on the local catalogue in lib/products.ts and checkout stays in demo mode.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# Server-only — needed to save orders. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>

# Admin panel (/admin) — owner password + random 32+ char secret that signs the session cookie.
ADMIN_PASSWORD=<choose a strong password>
ADMIN_SESSION_SECRET=<random 48 characters>
ADMIN_EMAIL=admin@yourstore.pk
ADMIN_NAME=Owner
NEXT_PUBLIC_SITE_URL=https://sezon.pk

# Optional: order confirmation emails (Gmail app password), Meta Pixel + Conversions API, PostEx courier.
# Pixel/CAPI and PostEx can also be set from Admin → Settings / Couriers.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
POSTEX_API_TOKEN=
COURIER_SYNC_CRON_SECRET=
