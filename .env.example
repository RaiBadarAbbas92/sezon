# Copy to .env.local and fill in (Supabase Dashboard → Project Settings → API).
# Without these the store runs on the local catalogue in lib/products.ts and checkout stays in demo mode.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# Server-only — needed to save orders. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>
